# Copie este arquivo para .env e ajuste os valores. NUNCA commite o .env.

# True somente no desenvolvimento local.
DEBUG=True

# Em produção use uma chave longa e aleatória. Para gerar uma:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-esta-chave

# Domínios aceitos, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para formulários (necessário fora do localhost), separadas por vírgula.
# CSRF_TRUSTED_ORIGINS=https://meu-dominio.com

# Deixe vazio para usar SQLite (db.sqlite3). Exemplo de PostgreSQL:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/gestao_problemas
DATABASE_URL=

# True apenas quando o site roda em HTTPS (Render).
USAR_HTTPS=False
